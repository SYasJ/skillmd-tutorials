if .type=="assistant" then (.message.content[] | if .type=="tool_use" then "▶ " + .name + "  " + ((.input.command // .input.file_path // .input.path // "")|tostring|.[0:80]) elif .type=="text" then "  " + (.text|gsub("\n";" ")|.[0:220]) else empty end) elif .type=="user" then (.message.content[]? | select(type=="object" and .type=="tool_result") | (if .is_error then "  ✖ " else "  ✓ " end) + ((.content|if type=="array" then (map(.text? // "")|join(" ")) else tostring end)|gsub("\n";" ")|.[0:130])) elif .type=="result" then "✔ done in \((.duration_ms/1000*10|floor)/10) s" else empty end
